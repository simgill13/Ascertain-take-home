# Copy to .env and adjust. Every value has a working default for local use.

# PostgreSQL (used by the db service and to build DATABASE_URL for the backend)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=healthcare
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=8000
LOG_LEVEL=INFO
SEED_ON_STARTUP=true
CORS_ORIGINS=["http://localhost:8080","http://localhost:5173"]

# Summary narrative: template (default, offline), anthropic, or openai.
# LLM providers need the matching API key and fall back to the template on error.
SUMMARY_PROVIDER=template
SUMMARY_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Frontend
FRONTEND_PORT=8080
FRONTEND_DEV_PORT=5173
